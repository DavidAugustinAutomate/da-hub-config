# da-agent Konfiguration -> auf da-hub als /home/david/.da-agent-env ablegen, chmod 600
# Format: KEY=

# Telegram: Token des NEUEN Bots (BotFather), Chat-ID aus getUpdates
TELEGRAM_TOKEN=
ALLOWED_CHAT_ID=

# LiteLLM-Gateway (Key vorerst aus ~/.dahub-env); Modell über eigenen Alias in der LiteLLM-Config
