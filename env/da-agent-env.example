NC_APP_PASSWORD=
NC_BASE=
KERN_TARGET=
MEMORY_SUGGESTIONS=

# Mailversand (leer lassen =
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Verhalten
TZ_NAME=
HISTORY_MESSAGES=
